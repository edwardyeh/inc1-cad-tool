{
    "table_format": 
    {
        "active_tab": "Pinmux",
        "function": 
        {
            "rid": 2, 
            "crange": [],
            "pattern": ["Function \\d+"]
        },
        "pad_name": 
        {
            "rid": 4,
            "pattern": "Pad Name",
            "style": "upper"
        },
        "ref_name": 
        {
            "rid": 4,
            "pattern": "Pad Cell Name"
        },
        "ignore":
        {
            "hide_row": true,
            "font_strike": true,
            "font_color_rgb": "ffffffff",
            "font_color_index": 0,
            "font_color_theme": 0
        }
    },
    "function": 
    {
        "SDIO": 
        {
            "sgroup": [ {"pat": "SDIO(\\d*)_.+", "rep": "SDIO\\1"} ],
            "clock":  [ "SDIO\\d*_CLK.*" ],
            "custom": { "SDIO\\d*_D(?:0|1).*": "DATA_H" }
        },
        "BMC":
        {
            "sgroup": [ {"pat": "BMC_\\w+", "rep": "BMC"} ],
            "clock":  [ "\\w+_CLK" ],
            "custom": {}
        },
        "JTAG":
        {
            "sgroup": [ {"pat": "JTAG_\\w+", "rep": "JTAG"} ],
            "clock":  [ "\\w+_TCK" ],
            "custom": {}
        }
    },
    "ignore":
    {
        "FUNC": "FUNC_\\w+",
        "FUNC2": "FUNC2_\\w+"
    },
    "partition":
    {
        "top1": ["MC\\d+", "PGPIO\\d+"]
    }
}
